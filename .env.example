# Primary provider. Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional cross-check provider (packages/jev has a second adapter for it).
# Get a key at https://vercel.com/dashboard/ai-gateway
AI_GATEWAY_API_KEY=

# Pin an exact JEV build. jev-latest is for drift checks only.
JEV_MODEL=jev-1.13
