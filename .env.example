# Primary provider. Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional cross-check provider (packages/jev has a second adapter for it).
# Get a key at https://vercel.com/dashboard/ai-gateway
AI_GATEWAY_API_KEY=

# Pin an exact JEV build. jev-latest is for drift checks only.
JEV_MODEL=jev-1.13

# Any long random string: openssl rand -hex 32
JWT_SECRET=
MONGO_URI=mongodb://127.0.0.1:27017

# Google sign-in (console.cloud.google.com -> Credentials -> OAuth client -> Web)
# Authorised redirect URI: http://localhost:8787/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments: Dodo Payments (optional; buying credits is off without these) ---
# Dashboard → Developer → API Keys, and Developer → Webhooks (endpoint: <APP_URL>/webhooks/dodo,
# events: payment.succeeded, payment.failed, payment.cancelled).
DODO_API_KEY=
DODO_WEBHOOK_SECRET=whsec_...
DODO_MODE=test
# One one-time product per pack, priced to match packages/shared/src/billing.ts ($9 / $29 / $99).
DODO_PRODUCT_STARTER=pdt_...
DODO_PRODUCT_PRO=pdt_...
DODO_PRODUCT_TEAM=pdt_...
