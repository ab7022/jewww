{
  "name": "jev-browser",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "smoke": "tsx --env-file-if-exists=.env packages/jev/test/smoke.ts",
    "eval:capture": "tsx --env-file-if-exists=.env eval/src/capture.ts",
    "eval:label": "tsx --env-file-if-exists=.env eval/src/label.ts",
    "eval:bench": "tsx --env-file-if-exists=.env eval/src/bench.ts",
    "plan": "tsx --env-file-if-exists=.env eval/src/plan-one.ts",
    "eval:plans": "tsx --env-file-if-exists=.env eval/src/bench-plan.ts",
    "eval:fields": "tsx --env-file-if-exists=.env eval/src/bench-fields.ts",
    "eval:select": "tsx --env-file-if-exists=.env eval/src/bench-select.ts",
    "check:guards": "tsx eval/src/check-guards.ts",
    "run-task": "tsx --env-file-if-exists=.env apps/runner/src/index.ts",
    "server": "tsx --env-file-if-exists=.env apps/server/src/index.ts",
    "build:extension": "pnpm --filter @jev-browser/extension build",
    "check:extension": "pnpm build:extension && tsx apps/extension/test/load-check.ts",
    "check:executor": "tsx eval/src/check-executor.ts",
    "preview:panel": "pnpm build:extension && tsx eval/src/preview-panel.ts",
    "verify": "pnpm typecheck && pnpm test",
    "gauntlet": "pnpm --filter @jev-browser/extension build:test && tsx eval/src/gauntlet/conformance.ts",
    "build:web": "pnpm --filter @jev-browser/web build",
    "gauntlet:agent": "tsx --env-file-if-exists=.env eval/src/gauntlet/agent.ts",
    "build:vercel": "pnpm build:web && tsx apps/server/scripts/vercel-build.ts",
    "build:extension:local": "VITE_API_BASE=http://localhost:8787 pnpm --filter @jev-browser/extension build --outDir dist-local",
    "package:extension": "pnpm build:extension && tsx apps/extension/scripts/package.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^24.0.0",
    "happy-dom": "^20.0.0",
    "playwright": "^1.50.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
